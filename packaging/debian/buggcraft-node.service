[Unit]
Description=Buggcraft native Minecraft node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=buggcraft-node
Group=buggcraft-node
WorkingDirectory=/usr/lib/buggcraft-node
ExecStart=/usr/bin/buggcraft-node serve --directory /var/lib/buggcraft-node --no-browser
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
StateDirectory=buggcraft-node
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/buggcraft-node
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
