# Portable baseline plus isolated CPU-specific translation units. Do not add ISA
# flags to a complete executable, SDK library, or dependency target.
option(BUGGCRAFT_SIMD "Build runtime-dispatched native byte scans" ON)
# Pinned upstream codecs supply the transformation itself; our common module
# owns validation, format policy and immutable, thread-safe CPU dispatch.
set(native_cpu "${CMAKE_SYSTEM_PROCESSOR}")
if(MSVC AND CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
  set(native_cpu "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
endif()
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
  list(LENGTH CMAKE_OSX_ARCHITECTURES native_arch_count)
  if(native_arch_count EQUAL 1)
    set(native_cpu "${CMAKE_OSX_ARCHITECTURES}")
  else()
    set(native_cpu universal)
  endif()
endif()
if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/.deps/base64-0.5.2/CMakeLists.txt")
  message(FATAL_ERROR "Missing pinned base64 dependency: run python scripts/fetch_deps.py")
endif()
function(buggcraft_add_base64)
  set(BUILD_SHARED_LIBS OFF)
  foreach(option BUILD_CLI BUILD_TESTS WERROR WITH_OpenMP WITH_SSSE3 WITH_SSE41 WITH_SSE42 WITH_AVX WITH_AVX2 WITH_AVX512 WITH_NEON32 WITH_NEON64)
    set(BASE64_${option} OFF CACHE BOOL "Buggcraft codec configuration" FORCE)
  endforeach()
  if(BUGGCRAFT_SIMD AND native_cpu MATCHES "^(AMD64|amd64|x86_64|x64|i[3-6]86)$")
    set(BASE64_WITH_AVX2 ON CACHE BOOL "Buggcraft codec configuration" FORCE)
  elseif(BUGGCRAFT_SIMD AND NOT MSVC AND native_cpu MATCHES "^(aarch64|arm64|ARM64)$")
    set(BASE64_WITH_NEON64 ON CACHE BOOL "Buggcraft codec configuration" FORCE)
  endif()
  add_subdirectory(.deps/base64-0.5.2 base64-build EXCLUDE_FROM_ALL)
  set_target_properties(base64 PROPERTIES INTERPROCEDURAL_OPTIMIZATION FALSE C_VISIBILITY_PRESET hidden)
endfunction()
buggcraft_add_base64()
add_library(buggcraft-encoding STATIC core/encoding.cpp core/digest.cpp)
target_link_libraries(buggcraft-encoding PUBLIC OpenSSL::Crypto PRIVATE base64 Threads::Threads)
target_include_directories(buggcraft-encoding PRIVATE .deps/base64-0.5.2/lib "${CMAKE_CURRENT_BINARY_DIR}/base64-build")
if(BASE64_WITH_NEON64)
  target_compile_definitions(buggcraft-encoding PRIVATE BUGGCRAFT_BASE64_NEON)
endif()
set_target_properties(buggcraft-encoding PROPERTIES CXX_VISIBILITY_PRESET hidden)
if(BUGGCRAFT_SIMD)
  # Universal Apple builds take the portable path; each architecture's ordinary
  # build enables its own kernels. Never infer the target from the host CPU.
  if(native_cpu MATCHES "^(AMD64|amd64|x86_64|x64|i[3-6]86)$")
    foreach(isa sse2 avx2 avx512)
      add_library(buggcraft-scan-${isa} OBJECT core/encoding_simd.cpp)
      set_property(TARGET buggcraft-scan-${isa} PROPERTY INTERPROCEDURAL_OPTIMIZATION FALSE)
      string(TOUPPER "${isa}" isa_upper)
      target_compile_definitions(buggcraft-scan-${isa} PRIVATE BUGGCRAFT_SCAN_${isa_upper})
      if(MSVC)
        if(isa STREQUAL "avx2")
          target_compile_options(buggcraft-scan-${isa} PRIVATE /arch:AVX2)
        elseif(isa STREQUAL "avx512")
          target_compile_options(buggcraft-scan-${isa} PRIVATE /arch:AVX512)
        endif()
      else()
        if(isa STREQUAL "avx512")
          target_compile_options(buggcraft-scan-${isa} PRIVATE -mavx512f -mavx512bw)
        else()
          target_compile_options(buggcraft-scan-${isa} PRIVATE -m${isa})
        endif()
      endif()
      target_sources(buggcraft-encoding PRIVATE $<TARGET_OBJECTS:buggcraft-scan-${isa}>)
    endforeach()
    target_compile_definitions(buggcraft-encoding PRIVATE BUGGCRAFT_X86_SCANS)
  elseif(native_cpu MATCHES "^(aarch64|arm64|ARM64)$")
    target_sources(buggcraft-encoding PRIVATE core/encoding_simd.cpp)
    target_compile_definitions(buggcraft-encoding PRIVATE BUGGCRAFT_NEON_SCAN BUGGCRAFT_SCAN_NEON)
  endif()
endif()
# Keep dispatch boundaries outside IPO so cross-ISA inlining cannot escape.
set_property(TARGET buggcraft-encoding PROPERTY INTERPROCEDURAL_OPTIMIZATION FALSE)
if(BUGGCRAFT_SANITIZERS AND NOT MSVC)
  foreach(target base64 buggcraft-encoding buggcraft-scan-sse2 buggcraft-scan-avx2 buggcraft-scan-avx512)
    if(TARGET ${target})
      target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    endif()
  endforeach()
endif()
